// 接口：保存签名
app.post("/api/consent", async (req, res) => {
  try {
    const { candidate_id, signature } = req.body;
    if (!candidate_id || !signature) {
      return res.status(400).json({ error: "Missing candidate_id or signature" });
    }
    const imgBuffer = Buffer.from(signature, "base64");
    const [result] = await pool.execute(
      `INSERT INTO candidate_signatures(candidate_id, signature_blob)
       VALUES (?, ?)`, 
      [candidate_id, imgBuffer]
    );
    res.json({ success: true, insertId: result.insertId });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Internal server error" });
  }
});


// GET /api/signature?id=123
app.get("/api/signature", async (req, res) => {
  const id = parseInt(req.query.id, 10);
  if (!id) {
    return res.status(400).json({ error: "Missing id" });
  }
  try {
    const [rows] = await pool.execute(
      "SELECT signature_blob FROM candidate_signatures WHERE id = ?",
      [id]
    );
    if (!rows.length) {
      return res.status(404).json({ error: "Not found" });
    }
    const blob = rows[0].signature_blob;
    // 假设存的是 PNG，如果是 JPEG 请改成 'jpeg'
    res.type("png");
    res.send(blob);
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Internal server error" });
  }
});
//end 


// SPA fallback
app.get("*", (req, res) => {
  res.sendFile(path.join("/var/www/html/gdpr-consent/public", "index.html"));
});

// 启动
const PORT = 3000;
app.listen(PORT, () => console.log(`API listening on port ${PORT}`));

